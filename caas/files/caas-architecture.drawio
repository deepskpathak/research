<mxfile host="app.diagrams.net"><diagram id="caas" name="CaaS Architecture"><mxGraphModel dx="1400" dy="1600" grid="1" gridSize="10" guides="1" page="1" pageWidth="1290" pageHeight="1530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Context as a Service (CaaS): governed knowledge preparation + task-specific context delivery" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1250" height="36" as="geometry"/></mxCell><mxCell id="bandA" value="&lt;b&gt;1 · KNOWLEDGE PREPARATION  (build time, change-driven)&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontColor=#424242;fontSize=13;verticalAlign=top;spacingTop=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1250" height="680" as="geometry"/></mxCell><mxCell id="bandB" value="&lt;b&gt;2 · TASK-SPECIFIC CONTEXT DELIVERY  (runtime, per request)&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontColor=#424242;fontSize=13;verticalAlign=top;spacingTop=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1250" height="740" as="geometry"/></mxCell><mxCell id="src0" value="&lt;b&gt;Engineering docs&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;EngHub / SharePoint&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#263238;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="230" height="60" as="geometry"/></mxCell><mxCell id="src1" value="&lt;b&gt;Standards &amp;amp; controls&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Policies / guidelines&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#263238;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="230" height="60" as="geometry"/></mxCell><mxCell id="src2" value="&lt;b&gt;Repositories&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Code / configs / ADRs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#263238;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="230" height="60" as="geometry"/></mxCell><mxCell id="src3" value="&lt;b&gt;Jira / Confluence&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Specs / decisions&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#263238;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="230" height="60" as="geometry"/></mxCell><mxCell id="src4" value="&lt;b&gt;Code graph / SDLC&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Dependency structure&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#263238;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="230" height="60" as="geometry"/></mxCell><mxCell id="src5" value="&lt;b&gt;Runtime evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Builds, tests, scans&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#263238;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="230" height="60" as="geometry"/></mxCell><mxCell id="f0" value="&lt;b&gt;Source-owned pipelines&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Triggered by commit, edit, schema or policy update&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="280" height="60" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;1. Connect &amp;amp; Extract&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Pull / push / events&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="280" height="60" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;2. Normalize&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Canonical document + metadata contract&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="280" height="60" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;3. Shape for Tasks&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Summaries, sections, pointers, relationships&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="380" width="280" height="60" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;4. Enrich &amp;amp; Govern&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Owner, classification, entitlement, trust, version, timestamp&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="460" width="280" height="60" as="geometry"/></mxCell><mxCell id="f5" value="&lt;b&gt;5. Certify&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Quality, provenance, compliance, safety; fail closed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="540" width="280" height="60" as="geometry"/></mxCell><mxCell id="f6" value="&lt;b&gt;6. Index &amp;amp; Publish&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Semantic, lexical, graph and metadata indexes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="620" width="280" height="60" as="geometry"/></mxCell><mxCell id="plane" value="&lt;b&gt;GOVERNED CONTEXT PLANE&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=13;verticalAlign=top;spacingTop=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="680" y="350" width="540" height="330" as="geometry"/></mxCell><mxCell id="st0" value="&lt;b&gt;Document / object store&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="240" height="70" as="geometry"/></mxCell><mxCell id="st1" value="&lt;b&gt;Semantic + lexical index&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="240" height="70" as="geometry"/></mxCell><mxCell id="st2" value="&lt;b&gt;Knowledge / code graph&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Dependencies + links&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="240" height="70" as="geometry"/></mxCell><mxCell id="st3" value="&lt;b&gt;Metadata &amp;amp; semantic catalog&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="240" height="70" as="geometry"/></mxCell><mxCell id="st4" value="&lt;b&gt;Context cache&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Task / query keyed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="240" height="70" as="geometry"/></mxCell><mxCell id="st5" value="&lt;b&gt;Provenance &amp;amp; certification&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Records&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="580" width="240" height="70" as="geometry"/></mxCell><mxCell id="hSrc" value="&lt;b&gt;AUTHORITATIVE SOURCES&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="230" height="30" as="geometry"/></mxCell><mxCell id="hFac" value="&lt;b&gt;CONTEXT FACTORIES&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="280" height="30" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Agents / Harnesses&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Claude Code, Devin, Codex, GSCode, CI, future agents&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="230" height="80" as="geometry"/></mxCell><mxCell id="q1" value="&lt;b&gt;1. Receive Task&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Query, repo, workflow, task type, session state&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="830" width="200" height="80" as="geometry"/></mxCell><mxCell id="q2" value="&lt;b&gt;2. Identity &amp;amp; Scope&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Caller, entitlements, repo, data classification&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="570" y="830" width="200" height="80" as="geometry"/></mxCell><mxCell id="q3" value="&lt;b&gt;3. Understand Task&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Classify intent; identify standards + source types&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="800" y="830" width="190" height="80" as="geometry"/></mxCell><mxCell id="sLex" value="&lt;b&gt;Lexical search&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Exact terms&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#311B92;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1030" y="810" width="190" height="60" as="geometry"/></mxCell><mxCell id="sSem" value="&lt;b&gt;Semantic search&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Concepts / meaning&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#311B92;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1030" y="890" width="190" height="60" as="geometry"/></mxCell><mxCell id="sGr" value="&lt;b&gt;Graph traversal&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Code / deps / links&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#311B92;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1030" y="970" width="190" height="60" as="geometry"/></mxCell><mxCell id="q4" value="&lt;b&gt;4. Merge &amp;amp; Normalize&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Deduplicate and reconcile scores across sources&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1030" y="1080" width="190" height="150" as="geometry"/></mxCell><mxCell id="q5" value="&lt;b&gt;5. Filter &amp;amp; Policy&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Entitlement, trust, freshness, certification&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="800" y="1080" width="190" height="150" as="geometry"/></mxCell><mxCell id="q6" value="&lt;b&gt;6. Rerank for Task&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Authority + relevance + workflow stage + recency&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="570" y="1080" width="200" height="150" as="geometry"/></mxCell><mxCell id="q7" value="&lt;b&gt;7. Build Context Bundle&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Summary first&lt;br&gt;Applicable rules&lt;br&gt;Recommended skills / tools&lt;br&gt;Authoritative pointers&lt;br&gt;Citations + provenance&lt;br&gt;Detail retrieval handles&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="1080" width="200" height="150" as="geometry"/></mxCell><mxCell id="q8" value="&lt;b&gt;8. Budget &amp;amp; Condense&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Remove redundancy; fit model / context limits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="1080" width="230" height="150" as="geometry"/></mxCell><mxCell id="ret" value="&lt;b&gt;Return context&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;via MCP, API, CLI or plugin&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="230" height="80" as="geometry"/></mxCell><mxCell id="use" value="&lt;b&gt;Agent reasons&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;and performs SDLC work&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontSize=12;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="1290" width="200" height="80" as=